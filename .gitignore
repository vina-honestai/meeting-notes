# ============================================================
# 회의 내용은 절대 올라가지 않는다 — 이 저장소는 '도구'만 담는다.
# 폴더 구조는 유지해야 스크립트가 동작하므로 .gitkeep 만 예외로 둔다.
# ============================================================

# 녹음 원본
/recordings/*
!/recordings/.gitkeep

# 받아쓴 스크립트 (.txt/.srt) + 작업 로그
/transcripts/*
!/transcripts/.gitkeep

# 회의록
/minutes/*
!/minutes/.gitkeep

# ------------------------------------------------------------
# 음성인식 모델 — 2.9GB. GitHub 파일당 100MB 제한을 넘어 올라가지도 않는다.
# 받는 법은 README 참고.
# ------------------------------------------------------------
/models/*
!/models/.gitkeep

# 녹음/전사 중 상태 파일과 ffmpeg 로그
/.tb-rec/

# macOS
.DS_Store
